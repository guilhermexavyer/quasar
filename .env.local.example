# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Nenhuma destas variáveis pode ter o prefixo NEXT_PUBLIC_ (são só do servidor).

# Transaction Pooler (porta 6543), usado pelo sistema. Termine com ?sslmode=require
DATABASE_URL=

# Session Pooler (porta 5432), usado só pelos scripts de migração. Termine com ?sslmode=require
DATABASE_URL_MIGRACAO=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
