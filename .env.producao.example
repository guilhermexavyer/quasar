# Copie para .env.producao e preencha com os dados do projeto Supabase de PRODUÇÃO.
# Nunca faça commit do .env.producao, nem preencha valores reais neste modelo.
# Usado só pelos scripts (:producao e db:copiar-producao), nunca pelo sistema local.
# Supabase → projeto de produção → Connect (strings do banco) e Project Settings → API Keys (chave).

# Transaction Pooler (porta 6543). Termine com ?sslmode=require
# Formato: postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Session Pooler (porta 5432), usado pelos scripts de migração e de cópia. Termine com ?sslmode=require
# Formato: postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_MIGRACAO=

# Formato: https://<ref>.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_...) ou a service_role da aba Legacy API Keys
SUPABASE_SERVICE_ROLE_KEY=
